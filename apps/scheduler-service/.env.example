# =================================
# SCHEDULER SERVICE — Configurações
# =================================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Flux Delivery (sync automático de entregadores — a cada 6h)
# FLUX_DELIVERY_BASE_URL=https://delivery-flux-it.com.br
# FLUX_DELIVERY_OAUTH_CLIENT_ID=SD
# FLUX_DELIVERY_OAUTH_CLIENT_SECRET=
# FLUX_DELIVERY_USERNAME=
# FLUX_DELIVERY_PASSWORD=
# FLUX_DELIVERY_SKIP=false
# FLUX_SYNC_WORKSPACE_ID=
# FLUX_DRIVER_SYNC_ENABLED=true
# FLUX_DRIVER_SYNC_CRON=0 */6 * * *
# FLUX_DRIVER_SYNC_FORCE=false

# Autentique (sync de status de assinaturas)
# AUTENTIQUE_API_KEY=
# AUTENTIQUE_SYNC_ENABLED=false  # pausa polling/reconcile (custo API)
AUTENTIQUE_COOP_EMAIL=gustavo.rezende@rezendeas.com.br
# AUTENTIQUE_IGNORED_SIGNER_EMAILS=cooperativacoopmob@gmail.com

# Timezone
TZ=America/Sao_Paulo

# Server
PORT=3004
NODE_ENV=development
