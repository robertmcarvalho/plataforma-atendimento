# SCHEDULER SERVICE — Cloud Run production
NODE_ENV=production
PORT=3004
TZ=America/Sao_Paulo

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=definir_no_secret_manager

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Night mode orchestrator (00:00-06:00 BRT) — requer roles/run.admin na SA do scheduler
ORCHESTRATOR_NIGHT_MODE_ENABLED=true
ORCHESTRATOR_HEALTH_URL=https://flux-farma-orchestrator-XXXX.us-central1.run.app
ORCHESTRATOR_RUN_SERVICE=flux-farma-orchestrator
GCP_REGION=us-central1

# Autentique (sync de assinaturas)
AUTENTIQUE_API_KEY=definir_no_secret_manager
AUTENTIQUE_COOP_EMAIL=gustavo.rezende@rezendeas.com.br
# AUTENTIQUE_IGNORED_SIGNER_EMAILS=cooperativacoopmob@gmail.com
