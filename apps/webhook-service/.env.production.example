# WEBHOOK SERVICE — Cloud Run production
NODE_ENV=production
PORT=3002

# Public endpoint expected by Meta:
# https://webhook.aethera.ai/webhooks/whatsapp

# Meta / WhatsApp
META_VERIFY_TOKEN=definir_no_secret_manager
META_APP_SECRET=definir_no_secret_manager
# WEBHOOK_SKIP_SIGNATURE_VERIFY=false

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_INBOUND=whatsapp.inbound
PUBSUB_TOPIC_STATUS=whatsapp.status
