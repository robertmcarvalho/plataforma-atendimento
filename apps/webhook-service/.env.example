# ==============================
# WEBHOOK SERVICE — Configurações
# ==============================

# Meta / WhatsApp
META_VERIFY_TOKEN=seu_token_de_verificacao_webhook
META_APP_SECRET=seu_app_secret_da_meta

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_INBOUND=whatsapp.inbound
PUBSUB_TOPIC_STATUS=whatsapp.status

# Server
PORT=3002
NODE_ENV=development
