# ==================================
# ORCHESTRATOR SERVICE — Configurações
# ==================================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_SUBSCRIPTION_INBOUND=whatsapp.inbound-sub
PUBSUB_SUBSCRIPTION_STATUS=whatsapp.status-sub
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Meta WhatsApp API
META_PHONE_NUMBER_ID=seu_phone_number_id
META_ACCESS_TOKEN=seu_access_token_permanente

# Bot session TTL (em horas)
BOT_SESSION_TTL_HOURS=24

# Triagem guiada (setor → demanda) antes do funil legado por palavras-chave (recomendado).
# ORCHESTRATOR_GUIDED_INTAKE_FIRST=true

# UUID de um utilizador em `public.users` para autor de `internal_notes` geradas pelo bot (opcional; senão usa o primeiro user da tabela)
# ORCHESTRATOR_INTERNAL_NOTE_AUTHOR_ID=

# Server
PORT=3003
NODE_ENV=development
