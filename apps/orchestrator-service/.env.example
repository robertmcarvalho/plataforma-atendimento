# ==================================
# ORCHESTRATOR SERVICE — Configurações
# ==================================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_SUBSCRIPTION_INBOUND=whatsapp.inbound-sub
PUBSUB_SUBSCRIPTION_INBOUND_AUTO=whatsapp.inbound.auto-sub
PUBSUB_TOPIC_INBOUND_AUTO=whatsapp.inbound.auto
PUBSUB_SUBSCRIPTION_STATUS=whatsapp.status-sub
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Meta WhatsApp API
META_PHONE_NUMBER_ID=seu_phone_number_id
META_ACCESS_TOKEN=seu_access_token_permanente
META_GRAPH_VERSION=v19.0

# API interna (MCP tool calls → api-service)
INTERNAL_API_BASE_URL=http://localhost:3001
# INTERNAL_API_KEY=

# MCP (tool calls externos)
MCP_TIMEOUT_MS=8000
MCP_RETRY_MAX=1
# Lista separada por vírgula; vazio = todas habilitadas
# MCP_ENABLED_TOOLS=

# Bot session TTL (em horas)
BOT_SESSION_TTL_HOURS=24

# Triagem guiada (setor → demanda) antes do funil legado por palavras-chave (recomendado).
# ORCHESTRATOR_GUIDED_INTAKE_FIRST=true

# Sessão legada bot_session (padrão: true)
# ORCHESTRATOR_LEGACY_BOT_SESSION_ENABLED=true

# Metas de latência interna (ms) para métricas / alertas
ORCHESTRATOR_TARGET_INBOUND_ACK_MS=1000
ORCHESTRATOR_TARGET_MESSAGE_PERSISTED_MS=3000
ORCHESTRATOR_TARGET_BOT_REPLY_SENT_MS=5000
ORCHESTRATOR_TARGET_TOTAL_PROCESSING_MS=10000

# UUID de um utilizador em `public.users` para autor de `internal_notes` geradas pelo bot (opcional; senão usa o primeiro user da tabela)
# ORCHESTRATOR_INTERNAL_NOTE_AUTHOR_ID=

# Server
PORT=3003
NODE_ENV=development
