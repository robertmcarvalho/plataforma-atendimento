# ===========================
# API SERVICE — Configurações
# ===========================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# JWT (deve ser igual ao secret do Supabase ou proprio)
JWT_SECRET=seu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=8h
INTEGRATIONS_ENCRYPTION_KEY=chave_local_para_criptografia_de_credenciais
USER_TEMP_PASSWORD_RESPONSE_ENABLED=true

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Meta WhatsApp API
META_PHONE_NUMBER_ID=seu_phone_number_id
META_ACCESS_TOKEN=seu_access_token_permanente

# WhatsApp (portal líder): número do negócio em E.164 para gerar QR (ex: +5511999999999)
WORKSPACE_WHATSAPP_BUSINESS_E164=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development

# Copiloto interno (Gemini) — somente servidor; nunca expor a chave no frontend
# Chave: Google AI Studio / API key com billing conforme política do projeto
GOOGLE_API_KEY=
# Alternativa aceita pelo código: GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Lista de fallback em ordem (separada por virgula) para 429/5xx
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Desligar o endpoint: false | 0 | off
COPILOT_ENABLED=true
AI_ANALYSIS_ENABLED=true
AI_INBOUND_ASSIST_ENABLED=true
AI_TOPIC_THRESHOLD=0.78
AI_MAX_TOPICS=100

# Supabase Storage (bucket para exportações)
STORAGE_BUCKET=exports
