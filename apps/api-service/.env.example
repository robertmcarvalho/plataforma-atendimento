# ===========================
# API SERVICE — Configurações
# ===========================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# JWT (deve ser igual ao secret do Supabase ou proprio)
JWT_SECRET=seu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=8h
INTEGRATIONS_ENCRYPTION_KEY=chave_local_para_criptografia_de_credenciais
USER_TEMP_PASSWORD_RESPONSE_ENABLED=true
# Desabilita editor JSON de roles na API (padrão: habilitado)
# DISABLE_ROLE_JSON_EDITOR=false

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Meta WhatsApp API (canal primário)
META_PHONE_NUMBER_ID=seu_phone_number_id
META_ACCESS_TOKEN=seu_access_token_permanente
# Aliases aceitos pelo código: META_WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_PHONE_NUMBER_ID
# Aliases de token: META_WHATSAPP_ACCESS_TOKEN, WHATSAPP_ACCESS_TOKEN
META_GRAPH_VERSION=v21.0
# Subscrição de webhook na Meta (Configurações → Integrações)
# META_APP_ID=
# META_GRAPH_APP_ACCESS_TOKEN=
# META_APP_ACCESS_TOKEN=
# META_WEBHOOK_SUBSCRIPTION_OBJECT=whatsapp_business_account
# META_WEBHOOK_SUBSCRIPTION_FIELDS=messages,message_template_status_update
# META_WABA_ID=

# WhatsApp (portal líder): número do negócio em E.164 para gerar QR (ex: +5511999999999)
WORKSPACE_WHATSAPP_BUSINESS_E164=
# Templates OTP líder (aliases: WHATSAPP_OTP_TEMPLATE_NAME / WHATSAPP_OTP_TEMPLATE_LANGUAGE)
# LEADER_WHATSAPP_OTP_TEMPLATE_NAME=aethera_leader_otp
# LEADER_WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
# LEADER_WHATSAPP_OTP_COPY_CODE_BUTTON=true
# LEADER_WHATSAPP_OTP_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Links para o frontend (convites, redirects)
# WEB_APP_URL=http://localhost:3000/login
# NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_DEV_PORT=3000

# Dev / bootstrap local (nunca true em produção)
ENABLE_DEV_ROUTES=false
# DEV_BOOTSTRAP_TOKEN=token_local_apenas_dev

# Automação legada (bot_flows / routing_rules) — padrão false
ALLOW_LEGACY_AUTOMATION_WRITES=false

# Rollup periódico de métricas de canal (ms; 0 = desligado)
CHANNEL_ROLLUP_INTERVAL_MS=0

# Server
PORT=3001
NODE_ENV=development

# Flux Delivery (dev: use homolog ou FLUX_DELIVERY_SKIP=true para viabilidade mock)
# FLUX_DELIVERY_BASE_URL=https://flux-delivery-homol.com.br
# FLUX_DELIVERY_OAUTH_CLIENT_ID=SD
# FLUX_DELIVERY_OAUTH_CLIENT_SECRET=
# FLUX_DELIVERY_USERNAME=
# FLUX_DELIVERY_PASSWORD=
# FLUX_DELIVERY_SKIP=true

# Billing — integrações Fase 5
# FLUX_MYSQL_HOST=flux.infinitybrasil.net
# FLUX_MYSQL_USER=root
# FLUX_MYSQL_PASSWORD=
# FLUX_MYSQL_DATABASE=dbfluxsinc
# BILLING_EXTERNAL_APP_TOKEN=
# BILLING_EXTERNAL_APP_WORKSPACE_ID=
COMMERCIAL_DATA_REQUEST_TTL_DAYS=7
COMMERCIAL_VIABILITY_CACHE_TTL_SEC=300

# Proposta comercial DOCX→PDF (Gotenberg). Local: docker compose up gotenberg -d
GOTENBERG_URL=http://localhost:3006

# Autentique (assinaturas digitais)
# AUTENTIQUE_API_KEY=
# AUTENTIQUE_SYNC_ENABLED=false  # pausa polling/reconcile (custo API)
# AUTENTIQUE_WEBHOOK_SECRET=
AUTENTIQUE_COOP_EMAIL=gustavo.rezende@rezendeas.com.br
# AUTENTIQUE_LAWYER_EMAIL=
# AUTENTIQUE_IGNORED_SIGNER_EMAILS=cooperativacoopmob@gmail.com

# E-mail transacional (SMTP) — opcional em dev
# SMTP_HOST=smtps.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Atendimento
# SMTP_SECURE=false

# Copiloto interno (Gemini) — somente servidor; nunca expor a chave no frontend
# Chave: Google AI Studio / API key com billing conforme política do projeto
GOOGLE_API_KEY=
# Alternativa aceita pelo código: GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Lista de fallback em ordem (separada por virgula) para 429/5xx
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Desligar o endpoint: false | 0 | off
COPILOT_ENABLED=true
AI_ANALYSIS_ENABLED=true
AI_INBOUND_ASSIST_ENABLED=true
AI_TOPIC_THRESHOLD=0.78
AI_MAX_TOPICS=100

# URL pública do webhook (usado por channel-runtime para montar links)
# WEBHOOK_PUBLIC_BASE_URL=http://localhost:3002
# PUBLIC_WEBHOOK_BASE_URL=
# WEBHOOK_SERVICE_PUBLIC_URL=

# Supabase Storage (bucket para exportações)
STORAGE_BUCKET=exports

# NFS-e (Sefin Nacional) — Sprint 0+; default off até homologação
# Holerite (WhatsApp UTILITY — criar o modelo na Meta; ver docs/META_HOLERITE_PAGAMENTO_TEMPLATE.md)
# BILLING_PAYSLIP_WHATSAPP_TEMPLATE_NAME=flux_holerite_pagamento
# BILLING_PAYSLIP_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# BILLING_PAYSLIP_TTL_DAYS=7

# BILLING_NFSE_ENABLED=false
# BILLING_NFSE_SAAS_ENABLED=false   # Sprint 5: exige ENABLED=true; editar/ativar perfis saas_*
# BILLING_NFSE_FORCE_PRODUCAO_RESTRITA=true

# DANFSe PDF — lib Java portal-patched (tools/xml-danfse-br); default ON se jar+JRE presentes
# BILLING_DANFSE_LIB_ENABLED=true
# BILLING_DANFSE_LIB_JAR=C:\Projeto\plataforma_atendimento\tools\xml-danfse-br\target\xml-danfse-br-cli.jar
# BILLING_DANFSE_JAVA_BIN=java
# BILLING_DANFSE_LIB_TIMEOUT_MS=60000

# Cora boletos (Integração Direta / mTLS) — MVP Flux; default off até Stage validado
# BILLING_CORA_ENABLED=false
# BILLING_CORA_SECRETS_DIR=   # opcional; default <repo>/.secrets
