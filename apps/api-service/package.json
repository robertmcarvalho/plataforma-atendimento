{
  "name": "api-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "backfill:uppercase-names": "node scripts/backfill-uppercase-names.mjs",
    "test:commercial-dimensioning": "node --import tsx --test src/lib/commercial/operationalDimensioningCore.test.ts src/lib/commercial/operationalDimensioning.test.ts src/lib/commercial/operationalScalePlanning.test.ts src/lib/commercial/commercialSnapshotFinance.test.ts src/lib/commercial/leadOperationalReadiness.test.ts src/lib/commercial/commercialStageRules.test.ts src/lib/commercial/commercialOperationalCopy.test.ts src/lib/commercial/docxInjectFieldValues.test.ts",
    "test:ops-task-catalog": "node --import tsx --test src/lib/opsTaskCatalog.test.ts",
    "test:billing-capital-separation": "node --import tsx --test src/lib/billingCapitalSeparation.test.ts",
    "test:billing-treasury": "node --import tsx --test src/lib/billingTreasuryEngine.test.ts",
    "test:billing-interest": "node --import tsx --test src/lib/billingInvoiceInterest.test.ts",
    "test:billing-payslip": "node --import tsx --test src/lib/billingPayslip.test.ts",
    "test:billing-cora": "node --import tsx --test src/lib/billingCoraClient.test.ts src/lib/billingCoraStatementMapper.test.ts",
    "smoke:cora-token": "node scripts/smoke-cora-token.mjs",
    "test:billing-daily-track": "node --import tsx --test tests/billingSettlementDailyPayTrack.test.ts tests/billingPayablesDailyExclude.test.ts tests/billingSettlementContractedDaily.test.ts src/lib/billingSettlementDayBase.test.ts",
    "smoke:capital-cooperativo": "node scripts/smoke-capital-cooperativo-report.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@google-cloud/pubsub": "^4.4.0",
    "@plataforma/ai-core": "file:../../packages/ai-core",
    "@plataforma/billing-engine": "file:../../packages/billing-engine",
    "@plataforma/channel-runtime": "file:../../packages/channel-runtime",
    "@plataforma/financial-cycle": "file:../../packages/financial-cycle",
    "@plataforma/flux-delivery": "file:../../packages/flux-delivery",
    "@plataforma/logger": "file:../../packages/logger",
    "@plataforma/operational-notes": "file:../../packages/operational-notes",
    "@plataforma/ops-task-catalog": "file:../../packages/ops-task-catalog",
    "@supabase/supabase-js": "^2.43.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pizzip": "^3.0.5",
    "@xmldom/xmldom": "^0.9.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.27.0",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.5",
    "mysql2": "^3.14.1",
    "node-forge": "^1.4.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.18.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.15",
    "@types/qrcode": "^1.5.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5"
  }
}
