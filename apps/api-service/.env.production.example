# API SERVICE — Cloud Run production
NODE_ENV=production
PORT=3001

# Public origins for CORS. Include every final frontend domain.
ALLOWED_ORIGINS=https://www.aetheraai.com.br,https://aetheraai.com.br,https://app.aethera.ai

# Link "Entrar na plataforma" nos e-mails de convite (provision / resend-invite).
WEB_APP_URL=https://www.aetheraai.com.br/login

# Dev/debug routes must stay disabled in production.
ENABLE_DEV_ROUTES=false
ALLOW_DEV_SCRIPTS=false
ALLOW_LEGACY_AUTOMATION_WRITES=false
CHANNEL_ROLLUP_INTERVAL_MS=0
# DISABLE_ROLE_JSON_EDITOR=false

# Supabase / auth
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=definir_no_secret_manager
# Chave anon (pública) — usada só para validar senha atual em PATCH /api/users/me/password
SUPABASE_ANON_KEY=mesma_chave_do_NEXT_PUBLIC_SUPABASE_ANON_KEY_do_web
JWT_SECRET=definir_no_secret_manager
JWT_EXPIRES_IN=8h
INTEGRATIONS_ENCRYPTION_KEY=definir_no_secret_manager
LEADER_WHATSAPP_OTP_SECRET=definir_no_secret_manager
USER_TEMP_PASSWORD_RESPONSE_ENABLED=false

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_TOPIC_CAMPAIGN=campaign.dispatch

# Meta WhatsApp API
META_PHONE_NUMBER_ID=definir_no_secret_manager
META_ACCESS_TOKEN=definir_no_secret_manager
META_GRAPH_VERSION=v21.0
META_APP_ID=definir_no_secret_manager
META_GRAPH_APP_ACCESS_TOKEN=definir_no_secret_manager
META_WEBHOOK_SUBSCRIPTION_OBJECT=whatsapp_business_account
META_WEBHOOK_SUBSCRIPTION_FIELDS=messages,message_template_status_update
# Opcional se waba_id não estiver no canal WhatsApp (Configurações → Canais)
META_WABA_ID=
WORKSPACE_WHATSAPP_BUSINESS_E164=
# Template Authentication aprovado na Meta (obrigatório para OTP do líder fora da janela 24h)
# Ver docs/META_LEADER_OTP_TEMPLATE.md — sugestão: aethera_leader_otp + pt_BR + copy code
LEADER_WHATSAPP_OTP_TEMPLATE_NAME=aethera_leader_otp
# Template utility para avisos de aprovação/reprovação de adiantamento em conversas só portal (fora da janela 24h)
WHATSAPP_ADVANCE_DECISION_TEMPLATE_NAME=
WHATSAPP_ADVANCE_DECISION_TEMPLATE_LANGUAGE=pt_BR
LEADER_WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
# Envio inclui parâmetro do botão copy code (padrão). Defina false se o template não tiver botão.
LEADER_WHATSAPP_OTP_COPY_CODE_BUTTON=true

# Autentique (assinaturas digitais)
AUTENTIQUE_API_KEY=definir_no_secret_manager
AUTENTIQUE_WEBHOOK_SECRET=definir_no_secret_manager
AUTENTIQUE_COOP_EMAIL=gustavo.rezende@rezendeas.com.br
# AUTENTIQUE_IGNORED_SIGNER_EMAILS=cooperativacoopmob@gmail.com

# Copiloto interno
GOOGLE_API_KEY=definir_no_secret_manager
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
COPILOT_ENABLED=true
AI_ANALYSIS_ENABLED=true
AI_INBOUND_ASSIST_ENABLED=true
AI_TOPIC_THRESHOLD=0.78
AI_MAX_TOPICS=100

# Supabase Storage
STORAGE_BUCKET=exports

# Flux Delivery (relatórios / viabilidade comercial) — credenciais no Secret Manager
FLUX_DELIVERY_BASE_URL=https://delivery-flux-it.com.br
FLUX_DELIVERY_OAUTH_CLIENT_ID=SD
# FLUX_DELIVERY_OAUTH_CLIENT_SECRET=secret_manager
# FLUX_DELIVERY_USERNAME=secret_manager
# FLUX_DELIVERY_PASSWORD=secret_manager
# FLUX_DELIVERY_SKIP=false
COMMERCIAL_DATA_REQUEST_TTL_DAYS=7
COMMERCIAL_VIABILITY_CACHE_TTL_SEC=300

# Holerite WhatsApp (UTILITY). Criar o modelo na Meta: docs/META_HOLERITE_PAGAMENTO_TEMPLATE.md
BILLING_PAYSLIP_WHATSAPP_TEMPLATE_NAME=flux_holerite_pagamento
BILLING_PAYSLIP_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
BILLING_PAYSLIP_TTL_DAYS=7

# E-mail transacional (UOL / SMTP) — preferir Secret Manager para SMTP_PASS em produção
SMTP_HOST=smtps.uhserver.com
SMTP_PORT=465
SMTP_USER=atendimento@fluxfarma.com.br
SMTP_FROM_EMAIL=atendimento@fluxfarma.com.br
SMTP_FROM_NAME=Atendimento
SMTP_SECURE=true
# SMTP_PASS=definir_no_secret_manager (secret: smtp-pass)
