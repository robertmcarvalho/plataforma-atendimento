# ==================================
# CAMPAIGN WORKER — Configurações
# ==================================

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Google Cloud Pub/Sub
GOOGLE_CLOUD_PROJECT_ID=seu_projeto_gcp
PUBSUB_SUBSCRIPTION_CAMPAIGN=campaign.dispatch-sub

# Meta WhatsApp API
META_PHONE_NUMBER_ID=seu_phone_number_id
META_ACCESS_TOKEN=seu_access_token_permanente

# Anti-ban defaults (sobrescrito pela config da campanha)
DEFAULT_BATCH_SIZE=10
DEFAULT_PAUSE_BETWEEN_MESSAGES_MS=1500
DEFAULT_PAUSE_BETWEEN_BATCHES_MS=60000
DEFAULT_MAX_PER_HOUR=200
DEFAULT_JITTER_MS=500

# Server
PORT=3005
NODE_ENV=development
